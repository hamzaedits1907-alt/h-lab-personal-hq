# Public client configuration only. These two values are SAFE to ship in the
# browser bundle: the anon/publishable key is limited by Row-Level Security.
#
# NEVER put the service_role / secret key in this file, in any VITE_* variable,
# in GitHub, or in Netlify "build" variables. See docs/SECURITY.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: name of the storage bucket created by the migrations.
# VITE_SUPABASE_BUCKET=hlab-media
